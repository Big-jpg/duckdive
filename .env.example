# Neon pooled URL for application traffic and app-schema writes.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Neon direct/unpooled URL for migrations, ingestion, and mart refreshes.
DATABASE_URL_UNPOOLED=
# Optional pooled/read-replica URL for read-only publication and stats queries.
DATABASE_READ_URL=

# Isolated estate identity. Point all database URLs at the VIC Neon project.
ESTATE_STATE=VIC
ESTATE_NAME=VIC House Data Lab
ESTATE_SOURCE_DIRECTORY=../rea_sales_data_model/VIC
ESTATE_PROPERTY_TYPE=House

# Created by a Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=

# MotherDuck's Vercel integration supplies the service token.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=vic_house_data
MOTHERDUCK_SHARE_URL=md:_share/vic_house_data/replace-with-share-id
MOTHERDUCK_SHARED_SERVICE_ACCOUNT_USERNAME=vic_house_lab
# Dedicated WHO fixture identity. Must differ from the VIC service account.
MOTHERDUCK_WHO_SERVICE_ACCOUNT_USERNAME=duckdive_who_phase2cc
MOTHERDUCK_API_BASE=https://api.motherduck.com
MOTHERDUCK_MCP_URL=https://api.motherduck.com/mcp
# Allowlisted demo Flight read by the authenticated `/flights` server component.
MOTHERDUCK_DEMO_FLIGHT_ID=
# Optional override; defaults to the current US East AWS endpoint.
MOTHERDUCK_PG_HOST=pg.us-east-1-aws.motherduck.com

# Protects ingestion endpoints.
INGEST_SECRET=replace-with-a-long-random-value

# Allowlisted Neon Auth magic links. Configure the Magic Link plugin and signed
# send.magic_link + user.before_create webhook in the Neon production branch.
NEON_AUTH_BASE_URL=https://replace-with-branch-auth-url/auth
NEON_AUTH_COOKIE_SECRET=replace-with-one-stable-random-value-at-least-32-characters
RESEND_API_KEY=
AUTH_EMAIL_FROM="DuckDive <noreply@duckdive.gold>"

# AI remixing.
OPENAI_API_KEY=
AI_MODEL_OPENAI=gpt-5.4
ANTHROPIC_API_KEY=
AI_MODEL_ANTHROPIC=claude-sonnet-4-6
AI_GATEWAY_API_KEY=
AI_MODEL_GATEWAY=openai/gpt-5.6-sol
AI_DEFAULT_PROVIDER=gateway
# VERCEL_OIDC_TOKEN is injected by Vercel runtime/CLI and must not be committed.
AI_REMIX_REQUESTS_PER_HOUR=20
AI_REMIX_GLOBAL_REQUESTS_PER_HOUR=100
PUBLIC_SHARE_REQUESTS_PER_HOUR=30
PUBLIC_SHARE_GLOBAL_REQUESTS_PER_HOUR=300
# Absolute public deployment URL, for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://duckdive.gold
